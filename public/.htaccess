# ============================================================
# RideGo — настройки Apache на zone.ee
# Только директивы, разрешённые в .htaccess на общем хостинге.
# Всё, что зависит от модулей, обёрнуто в <IfModule> — если модуля нет,
# блок просто игнорируется, а не роняет сайт в 500.
# ============================================================

AddDefaultCharset utf-8
ErrorDocument 404 /404.html

# ---------- www → без www ----------
# Каталог и сертификат на хостинге зовутся www.ridego.ee, но каноническим
# адресом в <link rel="canonical"> выбран ridego.ee — сводим сюда же.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.ridego\.ee$ [NC]
  RewriteRule ^(.*)$ https://ridego.ee/$1 [R=301,L]

  # ---------- /index.html → / ----------
  # Явный запрос index.html — технический дубль главной: та же страница по двум
  # адресам. Canonical их склеивает, но 301 честнее.
  # Условие смотрит на THE_REQUEST, то есть на исходную строку запроса от
  # браузера. Внутренняя подстановка index.html, которую делает DirectoryIndex
  # для «/», в THE_REQUEST не попадает — поэтому цикла нет.
  RewriteCond %{THE_REQUEST} \s/+(.*)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # ---------- старые адреса страниц маршрутов → с префиксом transfer- ----------
  # 13.08 шесть страниц переименованы: /tallinn-narva/ → /transfer-tallinn-narva/.
  # Старые URL успели уйти в IndexNow и в карту сайта, поэтому отдаём 301, а не 404:
  # так поисковики переносят накопленный вес на новый адрес.
  # Удалять правило не нужно — оно ничего не стоит и страхует внешние ссылки.
  RewriteRule ^(tallinn-narva|narva-tallinn|tallinn-koidula|koidula-tallinn|tallinn-luhamaa|luhamaa-tallinn)/?$ /transfer-$1/ [R=301,L]

  # ---------- WebP вместо JPEG, если браузер его понимает ----------
  # Рядом с каждым фото лежит .webp того же имени (см. tools/make-webp.sh).
  # Подмена срабатывает только при двух условиях сразу: браузер прислал
  # Accept: image/webp И файл .webp реально существует. Поэтому разметку
  # менять не пришлось — правило работает и для фото, которое подставляет JS.
  # og.png и иконки остаются PNG: для них .webp намеренно не сгенерирован,
  # соцсети и iOS ждут именно PNG.
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
  RewriteRule ^(.+)\.(jpe?g|png)$ $1.webp [T=image/webp,L]
</IfModule>

# ---------- сжатие ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ---------- кеширование ----------
# HTML не кешируем: деплой перезаписывает файлы, посетитель должен видеть свежую
# страницу. Статику кешируем на месяц — имена файлов стабильные, но и правки в
# styles.css случаются, поэтому не год.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  # Ответ счётчика (hits.php) кешировать нельзя — иначе число застынет.
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Счётчик посещений: ответ живой, ни браузеру, ни прокси его не кешировать.
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>

  # По одному и тому же адресу картинки может прийти JPEG или WebP — зависит от
  # заголовка Accept. Vary говорит кешам различать эти варианты, иначе браузеру
  # без поддержки WebP может достаться WebP из чужого кеша.
  <FilesMatch "\.(jpe?g|png)$">
    Header append Vary Accept
  </FilesMatch>

  # ---------- заголовки безопасности ----------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Страница не грузит ничего извне, поэтому default-src 'self'.
  # 'unsafe-inline' нужен из-за встроенного <script> в <head> (метка js) и
  # инлайновых style у колёс в SVG. Внешние скрипты всё равно заблокированы.
  # 'inline-speculation-rules' разрешает встроенный <script type="speculationrules">,
  # которым браузер заранее готовит следующую страницу.
  # frame-src открыт только для Google Maps: карта на странице-гиде вставляется
  # в iframe и без этой директивы попадала бы под default-src 'self'.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'inline-speculation-rules'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self' https://maps.google.com https://www.google.com; form-action 'none'; frame-ancestors 'self'; base-uri 'self'"

  # Сертификат Let's Encrypt выпущен 12.08.2026 на ridego.ee и www.ridego.ee,
  # оба имени отдают валидный HTTPS — HSTS включён.
  # Выключать обратно нельзя мгновенно: браузеры помнят max-age. Если понадобится
  # уйти с HTTPS, сначала поставь max-age=0 и дай пользователям зайти на сайт.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
