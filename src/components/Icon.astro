---
/** Иконки — те же пути, что в русском HTML, чтобы кнопки выглядели одинаково */
interface Props {
  name: "wa" | "tg" | "phone" | "car";
  class?: string;
}
const { name, class: cls = "size-[19px]" } = Astro.props;

const paths = {
  wa: "M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.2 1.2-1.9 1.2-.6 0-2.4-.3-4.6-2.3-2.2-2-2.7-3.7-2.8-4.3-.1-.7.4-1.7 1-1.9.3-.1.7 0 .9.3l.9 1.6c.1.3.1.6-.1.8l-.5.6c.5 1 1.5 2 2.5 2.5l.6-.5c.2-.2.5-.2.8-.1l1.6.8c.3.2.4.6.3.9Z",
  tg: "M21.9 4.3 18.8 19c-.2 1-.9 1.3-1.7.8l-4.6-3.4-2.2 2.1c-.3.3-.5.5-1 .5l.4-4.9 8.4-7.6c.4-.3-.1-.5-.6-.2L6.9 12.9 2.6 11.5c-.9-.3-.9-.9.2-1.4l18-6.9c.8-.3 1.4.2 1.1 1.1Z",
  phone: "M6.6 3.5h2.9l1.5 3.7-2 1.3a11 11 0 0 0 5 5l1.3-2 3.7 1.5v2.9a1.6 1.6 0 0 1-1.8 1.6A15.6 15.6 0 0 1 5 5.3 1.6 1.6 0 0 1 6.6 3.5Z",
};
---

{
  name === "car" ? (
    <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
      <path
        d="M3 15.5h18M6 15.5v2.2M18 15.5v2.2M4.2 15.5l1.9-6.1A2.5 2.5 0 0 1 8.5 7.6h7a2.5 2.5 0 0 1 2.4 1.8l1.9 6.1"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
      />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" class={`flex-none ${cls}`} aria-hidden="true">
      <path d={paths[name]} fill="currentColor" />
    </svg>
  )
}
